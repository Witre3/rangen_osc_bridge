<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rangen_osc_bridge</name>
  <version>0.1.0</version>
  <description>OSC bridge: publishes end-effector pose, velocity, and acceleration over OSC for musical mapping.</description>
  <maintainer email="tremblay.william@gmail.com">rangen</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>

  <exec_depend>python3-numpy</exec_depend>

  <!-- python-osc has no rosdep key and no Debian package; it is declared in
       setup.py install_requires instead.  Install it with pip, e.g.
       "pip install python-osc" (add the user/break-system-packages flags on
       Ubuntu 24.04).  The offline tool scripts/osc_to_midi.py also needs mido. -->

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
